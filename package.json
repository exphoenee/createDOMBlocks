{
  "name": "createdomblocks",
  "version": "2.0.1",
  "description": "Creating complex HTML blocks using JS.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "assets/createDOMBlocks.schema.json",
    "style.css",
    "README.md",
    "README-hu.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/gen-props.mjs && webpack",
    "build:page": "node -e \"require('fs').rmSync('dist-page',{recursive:true,force:true})\" && node scripts/gen-props.mjs && webpack && node scripts/build-page.mjs",
    "dev": "node scripts/gen-props.mjs && webpack serve --open",
    "dev:page": "node scripts/dev-page.mjs",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "node --test scripts/example-loader.test.mjs scripts/example-loader.format.test.mjs",
    "test:unit": "vitest run",
    "clean": "rm -rf dist dist-page"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exphoenee/createDOMBlocks.git"
  },
  "keywords": [
    "DOM",
    "dom manipulation",
    "typescript",
    "form elements",
    "ui components"
  ],
  "author": "VIKTOR, Bozzay",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/exphoenee/createDOMBlocks/issues"
  },
  "homepage": "https://github.com/exphoenee/createDOMBlocks#readme",
  "dependencies": {
    "domelemjs": "^2.0.1"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.0",
    "jsdom": "^31.0.1",
    "ts-loader": "^9.5.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.8",
    "vitest": "^5.1.1",
    "webpack": "^5.90.0",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
  }
}
