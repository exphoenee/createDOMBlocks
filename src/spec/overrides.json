{
  "Title": { "text": "text", "extra": ["level"] },
  "UnorderedList": { "array": "items", "extra": ["items"] },
  "OrderedList": { "array": "items", "extra": ["items"] },
  "Table": { "array": "data", "extra": ["data"], "optional": ["data"] },
  "Card": { "text": "title", "array": "body", "slots": { "body": ".card-body", "footer": ".card-footer" } },
  "Container": { "slots": { "children": "" } },
  "Grid": { "slots": { "children": "" } },
  "Accordion": { "array": "items", "items": { "items": "content" } },
  "Tabs": { "array": "tabs", "items": { "tabs": "content" } },
  "Drawer": { "elements": ["children"] },
  "Carousel": {
    "array": "slides",
    "extra": ["children"],
    "items": { "slides": "content" },
    "slots": { "children": ".carousel-stage" },
    "updaters": { "startIndex": "goTo" }
  },
  "Gantt": { "updaters": { "rows": "setRows", "selectedMilestoneId": "selectMilestone" } },
  "LocaleSwitcher": { "array": "locales", "updaters": { "value": "setValue", "locales": "setLocales" } },
  "SegmentedControl": { "array": "options", "bind": "value", "updaters": { "value": "setValue", "options": "setOptions" } },
  "ThemeToggle": { "updaters": { "theme": "setTheme" } },
  "Timeline": { "array": "items", "updaters": { "compact": "setCompact", "items": "setItems" } },
  "Modal": {
    "text": "title",
    "array": "body",
    "extra": ["title", "body", "ok", "cancel", "close"],
    "extraFns": ["ok", "cancel", "close"],
    "slots": { "body": ".modal-body > .spec-slot" },
    "portal": true
  },
  "Checkbox": { "bind": "checked" },
  "Radio": { "bind": "radio" },
  "TextInput": { "bind": "value" },
  "EmailInput": { "bind": "value" },
  "PasswordInput": { "bind": "value" },
  "UrlInput": { "bind": "value" },
  "TelInput": { "bind": "value" },
  "SearchInput": { "bind": "value" },
  "NumberInput": { "bind": "value" },
  "DateInput": { "bind": "value" },
  "DatetimeInput": { "bind": "value" },
  "TimeInput": { "bind": "value" },
  "MonthInput": { "bind": "value" },
  "WeekInput": { "bind": "value" },
  "ColorInput": { "bind": "value" },
  "RangeInput": { "bind": "value" },
  "Textarea": { "bind": "value" },
  "Select": { "bind": "value" },
  "HiddenInput": { "bind": "value" }
}
